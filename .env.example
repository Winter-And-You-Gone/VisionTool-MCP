# Copy this file to .env if your MCP launcher loads env files, or copy these
# variables into your MCP client configuration under the server's "env" block.

# API format: anthropic (default), openai, or gemini.
# - anthropic uses POST /v1/messages and x-api-key.
# - openai uses POST /v1/chat/completions and Bearer auth.
# - gemini uses POST /v1beta/models/{model}:generateContent with key=... in the query string.
VISIONTOOL_API_FORMAT=anthropic

# Unified key accepted for any API format. You can alternatively use provider keys:
# ANTHROPIC_API_KEY for anthropic, OPENAI_API_KEY for openai, GEMINI_API_KEY for gemini.
VISIONTOOL_API_KEY=sk-your-key-here

# Provider-specific key examples. Leave unused entries unset in real configs.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-openai-or-proxy-key-here
# GEMINI_API_KEY=AIza-your-gemini-key-here

# Model name. Defaults:
# - anthropic: claude-opus-4-8
# - openai: gpt-4o-mini
# - gemini: gemini-2.5-flash
VISIONTOOL_MODEL=claude-opus-4-8

# API base URL.
# Anthropic examples:
#   https://api.anthropic.com
#   https://api.anthropic.com/v1
#   https://api.anthropic.com/v1/messages
# OpenAI-compatible examples:
#   https://api.openai.com
#   https://api.openai.com/v1
#   https://api.openai.com/v1/chat/completions
#   https://your-proxy.example.com/openai/v1
# Gemini examples:
#   https://generativelanguage.googleapis.com
#   https://generativelanguage.googleapis.com/v1beta
#   https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
VISIONTOOL_BASE_URL=https://api.anthropic.com

# Optional runtime limits.
VISIONTOOL_TIMEOUT_MS=60000
VISIONTOOL_MAX_IMAGE_BYTES=5242880

# Optional image input safety boundaries.
# Leave VISIONTOOL_ALLOWED_IMAGE_ROOTS unset to allow any local image path the
# MCP server process can read. Multiple roots use the OS path delimiter:
#   Windows: C:\Screenshots;X:\Project\Images
#   POSIX: /tmp/screenshots:/workspace/images
# VISIONTOOL_ALLOWED_IMAGE_ROOTS=X:\Screenshots
#
# URL inputs are sent to the upstream vision provider. Disable or constrain them
# if the MCP client may see private/internal URLs.
# VISIONTOOL_DISABLE_URL_INPUTS=1
# VISIONTOOL_ALLOWED_URL_HOSTS=images.example.com,*.cdn.example.com
# Private/local URL hosts are rejected by default. Enable only when intentional.
# VISIONTOOL_ALLOW_PRIVATE_URLS=1

# Optional transient-failure retry settings.
VISIONTOOL_RETRIES=2
VISIONTOOL_RETRY_BASE_MS=250

# Optional proxy fallback settings. On retryable network errors the server first
# tries direct access, then falls back to:
#   VISIONTOOL_PROXY_URL, HTTPS_PROXY, HTTP_PROXY, or http://127.0.0.1:7890.
# VISIONTOOL_PROXY_URL=http://127.0.0.1:7890
# VISIONTOOL_DISABLE_PROXY_FALLBACK=1

# Optional caller-model blocklist. By default this server is open to any caller
# and _caller_model is NOT required - whether a model needs vision help is a
# context judgement (a multimodal model that can already see an image should not
# call), not an identity one, and the guardrail lives in each tool's description.
# Set this only when you want a hard guarantee that a specific model family never
# routes here. Once set, _caller_model becomes mandatory and matching callers are
# rejected. Matching is substring-based (case-insensitive): "gpt" blocks
# "gpt-4o", "opencode/gpt-5.5", and "azure-gpt-5" alike.
# VISIONTOOL_BLOCK_CALLER_PREFIXES=claude,gpt

# opencode integration (opencode-specific, opt-in).
# When enabled, the opencode_pasted_image tool is registered. It reads the most
# recently pasted image from the active opencode session directly out of the
# opencode SQLite database (opencode stores pasted images inline as base64 and
# never writes them to disk, so text-only caller models cannot receive them).
# This is ONLY useful when this MCP server runs inside an opencode session.
#
# Enable with VISIONTOOL_ENABLE_OPENCODE=1 (auto-detects the DB at
# ~/.local/share/opencode/opencode.db), or point at an explicit DB path with
# VISIONTOOL_OPENCODE_DB. Leave both unset to keep this tool unregistered.
# VISIONTOOL_ENABLE_OPENCODE=1
# VISIONTOOL_OPENCODE_DB=C:\Users\Winter\.local\share\opencode\opencode.db
