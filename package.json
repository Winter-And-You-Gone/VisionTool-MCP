{
  "name": "visiontool-mcp",
  "version": "0.1.0",
  "description": "Vision MCP server that lets text-only agents analyze images through a multimodal model.",
  "type": "module",
  "bin": {
    "visiontool-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx tests/*.test.ts",
    "smoke:vision": "tsx tests/smoke-vision.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "vision",
    "ocr",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "^16.6.1",
    "hpagent": "^1.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
